<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.services.AddWorkDayDialogFragment"
    android:padding="20dp"
    android:orientation="vertical">


    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/add_new_work_day"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown_day_of_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18sp"
            android:paddingEnd="5sp"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:hint="@string/weekday" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown_start_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18sp"
            android:paddingEnd="5sp"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:hint="@string/start_time" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown_end_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18sp"
            android:paddingEnd="5sp"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:hint="@string/end_time" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit_work_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.35"
            style="?attr/borderlessButtonStyle"
            android:text="@string/submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_work_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.35"
            style="?attr/borderlessButtonStyle"
            android:text="@string/cancel" />
    </LinearLayout>

</LinearLayout>
