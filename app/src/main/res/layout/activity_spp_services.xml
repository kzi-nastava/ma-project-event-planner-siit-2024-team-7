<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.SPPServicesActivity"
    android:background="@color/background_blue"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="25sp"
        android:layout_gravity="center"
        android:text="SERVICES"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/new_service_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="New service" />

        <com.google.android.material.search.SearchBar
            android:layout_width="180dp"
            android:layout_height="40dp"
            android:hint="Search service" />

    </LinearLayout>

    <fragment
        android:id="@+id/spp_services_fragment"
        android:name="rs.ac.uns.eventplanner.team7.fragments.SPPServicesFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>