<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.fragments.chats.ContactInfoDialogFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="10dp"
        >

        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="50dp">

            <ImageView
                android:id="@+id/chat_contract_profile_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/image_placeholder"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chat_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:textSize="24sp"
            android:text="@string/contact_name"
            android:textAlignment="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_profile_button"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_account"
                app:iconPadding="6dp"
                android:text="@string/profile" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_account_button"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:backgroundTint="@color/orange_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report"
                app:icon="@drawable/ic_feedback"
                app:iconPadding="8dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/block_account_button"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:backgroundTint="@color/red_delete"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_block"
                app:iconPadding="6dp"
                android:text="@string/block" />
        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/close_dialog_button"
        layout="@layout/view_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>