<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".fragments.ItemFiltersFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:orientation="horizontal"
        >

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filters"
            android:textSize="24sp"
            android:paddingHorizontal="20dp"
            />

        <include layout="@layout/space_divider"/>

        <include android:id="@+id/item_filters_close_button" layout="@layout/view_close_button"/>

    </LinearLayout>

    <include layout="@layout/divider_thick"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/shown_item_type_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/shown_item_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18sp"
                    android:paddingEnd="5sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="@string/show"/>

            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/divider_thin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="2dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="clear_text"
                android:hint="@string/name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_name_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/divider_thin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_availability_filter_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/product_availability_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18sp"
                    android:paddingEnd="5sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="@string/product_availability"/>

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/service_filters_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/service_date_range_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="20dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    android:hint="@string/date_range">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/service_date_range_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/divider_thin"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="20dp"
                    app:endIconMode="clear_text"
                    android:hint="@string/service_specifics">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/service_specifics_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/divider_thin"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="20dp"
                    app:endIconMode="clear_text"
                    android:hint="@string/minimum_duration">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/service_min_duration_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/divider_thin"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="20dp"
                    app:endIconMode="clear_text"
                    android:hint="@string/maximum_duration">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/service_max_duration_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/divider_thin"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="20dp"
                    app:endIconMode="clear_text"
                    android:hint="@string/reservation_deadline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/service_reservation_deadline_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"/>

                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/divider_thin"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="20dp"
                    app:endIconMode="clear_text"
                    android:hint="@string/cancellation_deadline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/service_cancellation_deadline_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <include layout="@layout/divider_thin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="2dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="clear_text"
                android:hint="@string/description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_description_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:minLines="3"
                    android:maxLines="3"
                    android:scrollbars="vertical"
                    android:overScrollMode="always" />

            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/divider_thin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="2dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="clear_text"
                android:hint="@string/price">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/item_price_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />

            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/divider_thin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_category_filter_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/item_category_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18sp"
                    android:paddingEnd="5sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="@string/item_category"/>

            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/divider_thin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_location_filter_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:paddingHorizontal="20dp"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/item_location_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18sp"
                    android:paddingEnd="5sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="@string/item_location" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/divider_thick"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_item_filters_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply"
            android:layout_weight="0.35"
            />

        <include layout="@layout/space_divider"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_item_filters_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset"
            android:layout_weight="0.35" />

    </LinearLayout>

</LinearLayout>