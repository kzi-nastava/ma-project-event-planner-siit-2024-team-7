<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".fragments.RejectCategoryFragment">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm deletion"
        android:textAlignment="center"
        android:textSize="20dp"
        android:textStyle="bold"/>

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/you_must_choose_a_replacement_category"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/replacement_category_dropdown_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:paddingHorizontal="20dp"
        app:endIconMode="dropdown_menu">

        <AutoCompleteTextView
            android:id="@+id/replacement_category_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18sp"
            android:paddingEnd="5sp"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:hint="@string/category" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_btn"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reject_category_btn"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            app:backgroundTint="@color/red_delete"
            android:text="Reject and use\nreplacement"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>